from typing import List

class Solution:
    def findTheString(self, lcp: List[List[int]]) -> str:
        n = len(lcp)
        res = [''] * n
        cur_char = 'a'
        
        for i in range(n):
            if res[i] == '':
                if cur_char > 'z':
                    return ""
                for j in range(i, n):
                    if lcp[i][j] > 0:
                        res[j] = cur_char
                cur_char = chr(ord(cur_char) + 1)
        
        dp = [[0]*n for _ in range(n)]
        
        for i in range(n-1, -1, -1):
            for j in range(n-1, -1, -1):
                if res[i] == res[j]:
                    if i == n-1 or j == n-1:
                        dp[i][j] = 1
                    else:
                        dp[i][j] = 1 + dp[i+1][j+1]
                else:
                    dp[i][j] = 0
        
        for i in range(n):
            for j in range(n):
                if dp[i][j] != lcp[i][j]:
                    return ""
        
        return "".join(res)
